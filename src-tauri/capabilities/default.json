{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Save dialog plus writing the exported file the user chose.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    }
  ]
}
